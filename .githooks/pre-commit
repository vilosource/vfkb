#!/bin/sh
# Commit identity guard (see identity-lib.sh). Runs for `git commit`, including --amend
# (git hands the amended commit's original author to the hook) and the SessionEnd
# auto-commit. Merges, cherry-picks, reverts and rebases do not run pre-commit; the
# pre-push hook checks every commit about to leave the clone.
. "$(dirname "$0")/identity-lib.sh"
vfkb_guard_off && exit 0

email_of() { git var "$1" 2>/dev/null | sed -n 's/.*<\(.*\)>.*/\1/p'; }
author=$(email_of GIT_AUTHOR_IDENT)
committer=$(email_of GIT_COMMITTER_IDENT)

if [ "$(lower "$author")" != "$VFKB_ALLOWED" ] || [ "$(lower "$committer")" != "$VFKB_ALLOWED" ]; then
  echo "vfkb pre-commit: refusing to commit as author <$author>, committer <$committer>." >&2
  vfkb_fix_hint
  exit 1
fi
exit 0
